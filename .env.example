# Synthesis API credentials (either key works; OpenRouter is preferred)
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=

# OpenAI-compatible API base URL (default: https://openrouter.ai/api/v1)
# OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Default model for synthesis (default: openrouter/auto)
# PAPER_MARKER_OPENROUTER_MODEL=openrouter/auto

# Per-route subprocess timeout in seconds (default: 300)
# PAPER_MARKER_TIMEOUT_PER_ROUTE=300

# Maximum parallel route workers (default: 4)
# PAPER_MARKER_MAX_PARALLEL_ROUTES=4

# Synthesis prompt budget: max characters per candidate (default: 12000)
# PAPER_MARKER_SYNTH_MAX_CHARS_PER_CANDIDATE=12000

# Synthesis prompt budget: max total characters (default: 30000)
# PAPER_MARKER_SYNTH_MAX_TOTAL_CHARS=30000

# Synthesis HTTP retries for transient errors 429/5xx (default: 2)
# PAPER_MARKER_SYNTH_HTTP_MAX_RETRIES=2

# Base backoff seconds between synthesis HTTP retries (default: 1.0)
# PAPER_MARKER_SYNTH_HTTP_BACKOFF_SECONDS=1.0

# Integration tests only: path to fixture catalog JSON
# PAPER_MARKER_FIXTURE_CATALOG=tests/fixtures/fixture_catalog.curated.json
